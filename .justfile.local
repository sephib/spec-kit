# Generated by Claude
# Local justfile for spec-kit fork management

# Default recipe
default:
    @just --list

# Merge current branch into local main and push to origin (not upstream)
merge-to-main:
    #!/usr/bin/env bash
    set -euo pipefail
    current_branch=$(git branch --show-current)
    if [[ "$current_branch" == "main" ]]; then
        echo "Already on main branch"
        exit 1
    fi
    echo "Merging $current_branch into main..."
    git checkout main
    git merge "$current_branch"
    git push origin main
    echo "Merged and pushed to origin/main (upstream untouched)"

# Sync local main with upstream without affecting origin
sync-upstream:
    #!/usr/bin/env bash
    set -euo pipefail
    git fetch upstream
    git checkout main
    git merge upstream/main
    echo "Local main synced with upstream"

# Sync local main with upstream and push to origin
sync-all:
    #!/usr/bin/env bash
    set -euo pipefail
    git fetch upstream
    git checkout main
    git merge upstream/main
    git push origin main
    echo "Synced with upstream and pushed to origin"

# Update from origin (fetch + pull with rebase)
update:
    git fetch origin && git pull origin main --rebase

# Show remote configuration
remotes:
    git remote -v

# Create a new feature branch from main
new-feature name:
    #!/usr/bin/env bash
    set -euo pipefail
    git checkout main
    git pull origin main
    git checkout -b "feat/{{name}}"
    echo "Created and switched to feat/{{name}}"

# Run the create-new-feature script
create-feature:
    bash scripts/bash/create-new-feature.sh

# Check prerequisites
check:
    bash scripts/bash/check-prerequisites.sh

# Setup plan
setup-plan:
    bash scripts/bash/setup-plan.sh

# Update agent context
update-context:
    bash scripts/bash/update-agent-context.sh
